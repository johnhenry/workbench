{
  "name": "workbench",
  "version": "0.0.0",
  "private": true,
  "description": "A small workbench app that proves mport, html-modules and window-algebra meet at the import map.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:offline": "node scripts/build.mjs --offline",
    "build:pages": "node scripts/build.mjs --base /workbench/ --out dist",
    "serve:pages": "node scripts/serve.mjs 4410 --dir dist --prefix /workbench/",
    "record:cdn": "node scripts/record-cdn.mjs",
    "serve": "node scripts/serve.mjs",
    "start": "npm run build && npm run serve",
    "test": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:smoke": "playwright test --config playwright.smoke.config.js",
    "test:pages": "playwright test --config playwright.pages.config.js"
  },
  "dependencies": {
    "@johnhenry/html-modules": "github:johnhenry/html-modules#b410eddc6b5c10dcd34e958d84f2c2f9ec9e1963",
    "@johnhenry/mport": "github:johnhenry/mport#f5109bfd20663df760fc60ffe8c055c9679ab04e",
    "@johnhenry/safe-fragment": "0.0.0",
    "@johnhenry/window-algebra": "github:johnhenry/window-algebra#fe20af1efb6febf07e8f45beb784d009e2a316e1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
